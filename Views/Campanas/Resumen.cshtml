@{
    ViewData["Title"] = "Resumen de Indicadores";
}

<div class="container mt-4">
    <h2 class="fw-bold mb-4">Resumen de Campañas</h2>

    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="card bg-dark text-white shadow-sm border-0 h-100">
                <div class="card-body text-center">
                    <h6 class="text-uppercase small">Total Campañas</h6>
                    <div class="display-5 fw-bold">@ViewBag.Total</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white shadow-sm border-0 h-100">
                <div class="card-body text-center">
                    <h6 class="text-uppercase small">Vigentes</h6>
                    <div class="display-5 fw-bold">@ViewBag.Vigentes</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-primary text-white shadow-sm border-0 h-100">
                <div class="card-body text-center">
                    <h6 class="text-uppercase small">Próximas</h6>
                    <div class="display-5 fw-bold">@ViewBag.Proximas</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-dark shadow-sm border-0 h-100">
                <div class="card-body text-center">
                    <h6 class="text-uppercase small">Promedio Descuento</h6>
                    <div class="display-5 fw-bold">@ViewBag.Promedio.ToString("F1")%</div>
                </div>
            </div>
        </div>
    </div>
    
    <a asp-action="Index" class="btn btn-outline-secondary">Volver al Listado</a>
</div>