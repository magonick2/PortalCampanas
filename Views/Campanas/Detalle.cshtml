@model PortalCampanas.Models.Campana

@{
    ViewData["Title"] = "Detalle de Campaña";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Listado</a></li>
                    <li class="breadcrumb-item active">@Model.Nombre</li>
                </ol>
            </nav>

            <div class="card shadow border-0">
                <div class="card-header bg-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h2 class="mb-0 fw-bold text-primary">@Model.Nombre</h2>
                        <span class="badge rounded-pill fs-6 @(Model.Estado == "Vigente" ? "bg-success" : (Model.Estado == "Próxima" ? "bg-primary" : "bg-secondary"))">
                            @Model.Estado
                        </span>
                    </div>
                </div>
                <div class="card-body p-4">
                    <div class="row">
                        <div class="col-md-7">
                            <h5 class="text-muted small fw-bold text-uppercase">Descripción</h5>
                            <p class="lead">@Model.Descripcion</p>
                            
                            <div class="row mt-4">
                                <div class="col-6">
                                    <h6 class="text-muted small fw-bold">Categoría</h6>
                                    <p>@Model.Categoria</p>
                                </div>
                                <div class="col-6">
                                    <h6 class="text-muted small fw-bold">Canal de Venta</h6>
                                    <p>@Model.Canal</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-5">
                            <div class="bg-light p-4 rounded-3 text-center border">
                                <h4 class="fw-bold">@Model.DescuentoPct% <span class="fs-6 text-muted">de Descuento</span></h4>
                                <hr />
                                <div class="text-start small">
                                    <p class="mb-1"><strong>Inicia:</strong> @Model.FechaInicio.ToString("dd/MM/yyyy")</p>
                                    <p class="mb-0"><strong>Finaliza:</strong> @Model.FechaFin.ToString("dd/MM/yyyy")</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-light text-end py-3">
                    <a asp-action="Index" class="btn btn-secondary px-4">Volver</a>
                </div>
            </div>
        </div>
    </div>
</div>